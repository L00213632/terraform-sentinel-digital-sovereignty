import "tfplan/v2" as tfplan

security_groups = filter tfplan.resource_changes as _, resource {
    resource.type is "aws_security_group" and
    resource.mode is "managed" and
    resource.change.actions is not ["delete"]
}

security_rules = filter tfplan.resource_changes as _, resource {
    resource.type is "aws_security_group_rule" and
    resource.mode is "managed" and
    resource.change.actions is not ["delete"]
}

inline_ssh_valid = rule {
    all security_groups as _, group {
        all group.change.after.ingress as _, ingress {
            ingress.from_port is not 22 or
            ingress.to_port is not 22 or
            ("0.0.0.0/0" not in ingress.cidr_blocks and "::/0" not in ingress.ipv6_cidr_blocks)
        }
    }
}

separate_ssh_valid = rule {
    all security_rules as _, sg_rule {
        sg_rule.change.after.type is not "ingress" or
        sg_rule.change.after.from_port is not 22 or
        sg_rule.change.after.to_port is not 22 or
        ("0.0.0.0/0" not in sg_rule.change.after.cidr_blocks and "::/0" not in sg_rule.change.after.ipv6_cidr_blocks)
    }
}

main = rule {
    inline_ssh_valid and separate_ssh_valid
}