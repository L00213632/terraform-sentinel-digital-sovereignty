					"terraform_data.digital_sovereignty_demo.input",
					"terraform_data.digital_sovereignty_demo",
				],
				"sensitive": false,
				"value":     undefined,
			},
			"security_status": {
				"depends_on":  [],
				"description": "",
				"references":  [],
				"sensitive":   false,
				"value":       "Digital sovereignty configuration created",
			},
		},
		"providers": {
			"terraform": {
				"alias": {
					"": {
						"config":     {},
